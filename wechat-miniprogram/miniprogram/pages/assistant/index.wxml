<view class="page"><view class="hero"><view class="eyebrow">EVIDENCE-GROUNDED ASSISTANT</view><view class="title">让建议带着来源</view><view class="subtitle">知识检索 · 官方工具核验 · 人工复核草稿</view></view><view class="card"><view class="row"><text>启用 DeepSeek Agent</text><switch checked="{{agent}}" color="#087f79" bindchange="mode" disabled="{{busy}}"/></view><view class="muted">关闭时仅运行来源核验，不调用语言模型。启用时需在服务端配置密钥。</view><textarea maxlength="2000" value="{{question}}" bindinput="input" placeholder="描述地区、时段和需要核对的活动场景"/><view class="actions"><button loading="{{busy}}" disabled="{{busy}}" bindtap="send">{{agent?'交给 Agent':'核验官方来源'}}</button><button class="secondary" disabled="{{busy}}" bindtap="clear">清空对话</button></view><view class="muted">{{status}}</view><view class="actions"><button class="secondary" bindtap="enterprise">将问题带入企业审批流程</button></view></view><view wx:if="{{answer}}" class="card"><view class="heading">核验结果</view><view class="answer" selectable="true">{{answer}}</view><view class="warning">建议用于人工复核，不能替代官方警告与现场判断。</view></view><view wx:for="{{drafts}}" wx:key="id" class="card"><view class="heading">待确认草稿：{{item.title}}</view><view class="muted">不会自动提交或完成工单。</view><view class="actions"><button bindtap="draft" data-index="{{index}}">载入工作台编辑</button></view></view><view wx:for="{{citations}}" wx:key="id" class="card"><view class="heading">{{item.title}}</view><view class="answer">{{item.text}}</view><view class="source">{{item.url}}</view><view class="actions"><button class="secondary" bindtap="source" data-url="{{item.url}}">复制引用链接</button></view></view><view class="card" wx:if="{{trace.length}}"><view class="heading">工具调用轨迹</view><view wx:for="{{trace}}" wx:key="id"><view class="badge">{{item.name}}</view><view class="answer muted" selectable="true">{{item.text}}</view></view></view><view class="card" wx:if="{{history.length}}"><view class="heading">本机对话记录</view><view wx:for="{{history}}" wx:key="index" class="row"><view><view class="badge">{{item.role==='user'?'我的问题':'助手回复'}}</view><view class="answer muted">{{item.content}}</view></view></view></view></view>
