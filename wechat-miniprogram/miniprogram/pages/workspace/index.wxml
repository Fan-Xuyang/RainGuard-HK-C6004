<view class="page"><view class="hero"><view class="eyebrow">FIELD OPERATIONS</view><view class="title">把现场复核落到实处</view><view class="subtitle">设施清单 · 复核任务 · 照片与现场记录</view><navigator url="/pages/enterprise/index" class="picker">进入企业审批工作流 →</navigator></view><picker range="{{regions}}" range-key="label" value="{{regionIndex}}" bindchange="region"><view class="picker">记录地区：{{regions[regionIndex].label}}　⌄</view></picker><view class="card"><view class="heading">{{selected?'编辑复核任务':'创建复核任务'}}</view><input value="{{title}}" data-field="title" bindinput="input" maxlength="240" placeholder="实际复核任务标题"/><input value="{{owner}}" data-field="owner" bindinput="input" maxlength="100" placeholder="负责人"/><textarea value="{{note}}" data-field="note" bindinput="input" maxlength="1200" placeholder="记录现场观察、依据和后续安排"/><checkbox-group bindchange="check"><label wx:for="{{checks}}" wx:key="*this" class="row"><checkbox color="#087f79" value="{{index}}" checked="{{checkedFlags[index]}}"/><text>{{item}}</text></label></checkbox-group><image wx:if="{{photo}}" class="photo" mode="aspectFit" src="{{photo}}"/><view class="actions"><button bindtap="save">保存记录</button><button class="secondary" bindtap="photo">添加现场照片</button><button class="secondary" bindtap="finish">人工完成</button><button class="secondary" bindtap="newRecord">新建</button></view></view><view class="card"><view class="heading">复核任务 · {{tasks.length}}</view><view wx:for="{{tasks}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="select"><view><view>{{item.title}}</view><text class="badge">{{item.statusLabel}}</text><text class="muted">{{item.label}} · {{item.owner||'未指定负责人'}}</text><view class="muted">{{item.stamp}}</view><view class="source">观测来源：{{item.evidence.rainOrigin}} · 雨量 {{item.evidence.rain===null?'—':item.evidence.rain}} mm</view></view></view><view wx:if="{{!tasks.length}}" class="empty">还没有实际任务，创建后显示在这里。</view></view><view class="card"><view class="heading">我的实际设施</view><input value="{{facility}}" data-field="facility" bindinput="input" maxlength="120" placeholder="例如你实际负责的场地或设施"/><button bindtap="facility">添加设施</button><view wx:for="{{facilities}}" wx:key="id" class="row"><text>{{item.name}}</text><text class="muted">{{item.label}}</text></view></view><view class="card"><view class="heading">现场情况记录</view><input value="{{place}}" data-field="place" bindinput="input" maxlength="240" placeholder="实际地点"/><textarea value="{{incidentNote}}" data-field="incidentNote" bindinput="input" maxlength="2000" placeholder="填写实际观察，系统不生成虚构现场事件"/><button bindtap="incident">保存现场记录</button><view wx:for="{{incidents}}" wx:key="id" class="row"><view><view>{{item.place}} · {{item.label}}</view><view>{{item.note}}</view><view class="muted">{{item.stamp}}</view></view></view></view><view class="card"><view class="heading">小组共享与备份</view><input password="true" value="{{token}}" data-field="token" bindinput="input" placeholder="共享口令（仅保存在本次运行内存）"/><view class="muted">{{message}}</view><view class="actions"><button class="secondary" bindtap="export">导出本机备份</button><button class="secondary" data-action="pull" bindtap="sync" disabled="{{busy}}">载入共享版本</button><button data-action="push" bindtap="sync" disabled="{{busy}}">提交共享版本</button></view></view></view>
