<view class="page"><view class="hero"><view class="eyebrow">EVIDENCE LIBRARY</view><view class="title">可追溯的官方知识</view><view class="subtitle">{{count}} 份资料 · {{chunks}} 段索引 · 支持离线检索</view></view><input placeholder="例如：暴雨、山泥倾泻、雷暴、潮位" value="{{query}}" bindinput="input" bindconfirm="search"/><view class="actions"><button bindtap="search">检索官方资料</button></view><view wx:for="{{results}}" wx:key="id" class="card"><view class="heading">{{item.title}}</view><view class="badge">{{item.publisher}}</view><view class="muted">存档时间：{{item.time}}</view><view wx:if="{{item.page}}" class="muted">原文 PDF 页码：{{item.page}}</view><view class="answer">{{item.text}}</view><view class="source">{{item.url}}</view><view class="actions"><button class="secondary" data-url="{{item.url}}" bindtap="copy">复制原文链接</button></view></view><view wx:if="{{!results.length}}" class="empty">未找到匹配资料，请换一个关键词。</view></view>
