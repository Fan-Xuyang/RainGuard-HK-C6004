page{background:#eff4f5;color:#193844;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.65}.page{padding:28rpx 28rpx 60rpx}.hero{background:linear-gradient(135deg,#102d3b,#14615f);padding:36rpx;border-radius:28rpx;color:white;margin-bottom:24rpx}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#99d7cf}.title{font-size:44rpx;font-weight:700;line-height:1.3;margin:12rpx 0}.subtitle{font-size:26rpx;color:#c5dfdf}.card{background:white;border:1rpx solid #dce7e8;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}.heading{font-size:31rpx;font-weight:700;margin-bottom:16rpx}.muted{color:#617983;font-size:24rpx}.badge{display:inline-block;font-size:22rpx;background:#e7f5f1;color:#14665f;border-radius:12rpx;padding:4rpx 14rpx;margin:6rpx 10rpx 6rpx 0}.warning{background:#fff0d9;color:#865500;padding:16rpx;border-radius:14rpx;font-size:24rpx;margin:12rpx 0}.danger{color:#a34237}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid #edf2f3}.row:last-child{border:0}.grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-bottom:20rpx}.metric{background:white;padding:24rpx;border-radius:22rpx;box-sizing:border-box;width:calc(50% - 8rpx);border:1rpx solid #dce7e8}.number{font-size:50rpx;font-weight:700;color:#087f79}.unit{font-size:24rpx;color:#667f89;margin-left:8rpx}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin:20rpx 0}button{font-size:27rpx;background:#087f79;color:#fff;border-radius:16rpx;margin:0;padding:0 24rpx;line-height:2.8}button::after{border:0}button.secondary{background:#e6f0f1;color:#284a58}button[disabled]{background:#b5c8ca;color:#fff}input,textarea{box-sizing:border-box;background:#f2f6f7;border:1rpx solid #dbe5e8;border-radius:14rpx;width:100%;padding:18rpx;margin:12rpx 0;font-size:27rpx}input{height:90rpx}textarea{height:190rpx}.picker{padding:16rpx;background:#e8f3f1;border-radius:14rpx;color:#13665f}.answer{white-space:pre-wrap;word-break:break-word;font-size:27rpx}.source{font-size:23rpx;color:#547780;word-break:break-all}.empty{padding:30rpx 0;color:#6f858b;text-align:center}.tagline{font-size:22rpx;color:#7c9198;text-align:center;margin-top:30rpx}image.photo{width:100%;height:320rpx;border-radius:12rpx;margin-top:16rpx}
